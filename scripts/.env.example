# Supabase project URL
SUPABASE_URL=

# Service role key (KEEP SECRET — never expose in the frontend / VITE_ vars)
SUPABASE_SERVICE_ROLE_KEY=

# imgbb image hosting API key (same as VITE_IMGBB_API_KEY in the app)
IMGBB_API_KEY=

# HMAC secret used to hash client IPs in the edge functions (vote, rate-limit, submit-rice)
# Generate with: openssl rand -hex 32. MUST match the IP_HASH_SECRET you set on the edge functions.
IP_HASH_SECRET=